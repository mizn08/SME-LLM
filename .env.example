# Copy to .env in the project root:  cp .env.example .env

# PostgreSQL (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bnpl_db
POSTGRES_PORT=5432

# FastAPI
API_PORT=8000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bnpl_db

# ML artefacts path inside the backend container
ML_MODELS_DIR=/app/backend/app/ml_models

# Optional pgAdmin (docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@bnpl.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# DB wait tuning (entrypoint scripts)
DB_WAIT_ATTEMPTS=60
DB_WAIT_INTERVAL=2

# v2 — RAG + LangChain (optional; works offline without LLM)
# Option A: Chutes.ai — POST https://llm.chutes.ai/v1/chat/completions
# Use either CHUTES_API_KEY or CHUTES_API_TOKEN (same Bearer token from chutes.ai)
CHUTES_API_KEY=
CHUTES_API_TOKEN=
CHUTES_API_KEY_1=
CHUTES_API_KEY_2=
CHUTES_BASE_URL=https://llm.chutes.ai/v1
CHUTES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
CHUTES_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
# Must be a valid Chutes model id (do not use Qwen here — 404 on Chutes)
CHUTES_FALLBACK_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
CHUTES_MAX_TOKENS=1024
CHUTES_TEMPERATURE=0.7
CHUTES_CHAT_TIMEOUT_SEC=90
CHUTES_MAX_RETRIES=4
# Option B: OpenAI (falls back to this if CHUTES_API_KEY is unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
APP_ENV=development
AWS_REGION=ap-southeast-1

# v3 — vector RAG, bandit, RL
USE_VECTOR_RAG=true
CHROMA_PERSIST_DIR=data/chroma
RL_Q_TABLE_PATH=data/rl_q_table.json
FINETUNE_ADAPTER_DIR=data/finetune_adapter
FINETUNE_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct

# v4 APC+ (auth off for local demo)
AUTH_REQUIRED=false
API_KEY=
JWT_SECRET=change-me-in-production
RATE_LIMIT=120/minute
