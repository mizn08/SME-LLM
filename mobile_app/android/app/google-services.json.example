{
  "_comment": "Copy to google-services.json after creating a Firebase Android app (package: com.example.bnpl_advisor_mobile)",
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "YOUR_PROJECT_ID",
    "storage_bucket": "YOUR_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "1:YOUR_PROJECT_NUMBER:android:YOUR_APP_HASH",
        "android_client_info": {
          "package_name": "com.example.bnpl_advisor_mobile"
        }
      },
      "oauth_client": [],
      "api_key": [{ "current_key": "YOUR_ANDROID_API_KEY" }],
      "services": {
        "appinvite_service": { "other_platform_oauth_client": [] }
      }
    }
  ],
  "configuration_version": "1"
}
